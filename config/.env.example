# ISX Pulse Environment Configuration
# Copy this file to .env and fill in your values
# For production, copy to .env.production with production values

# ============================================
# SERVER CONFIGURATION
# ============================================
PORT=8080
HOST=0.0.0.0
ENV=development  # Options: development, staging, production

# ============================================
# LOGGING & OBSERVABILITY
# ============================================
ISX_LOGGING_OUTPUT=console  # Options: console, json, file
LOG_LEVEL=info              # Options: debug, info, warn, error
LOG_FORMAT=text             # Options: text, json (use json in production)

# Enable metrics and tracing
ENABLE_METRICS=true
ENABLE_TRACING=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# ============================================
# SECURITY & AUTHENTICATION
# ============================================
# Generate with: openssl rand -hex 32
ENCRYPTION_KEY=
JWT_SECRET=

# Rate Limiting
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=1h

# Security Headers
ENABLE_SECURE_MODE=true      # Set to true in production
REQUIRE_SIGNATURE=true       # Set to true in production
ENABLE_ENCRYPTION=false       # Set to true when using encrypted credentials

# ============================================
# LICENSE SYSTEM
# ============================================
LICENSE_CHECK_INTERVAL=1h
LICENSE_GRACE_PERIOD=7d
MAX_LICENSE_ATTEMPTS=5
LICENSE_BLOCK_DURATION=15    # minutes
LICENSE_WINDOW_DURATION=60   # minutes

# ============================================
# GOOGLE SHEETS API
# ============================================
# For development, use credentials.json file
# For production, use encrypted_credentials.dat
GOOGLE_APPLICATION_CREDENTIALS=./credentials.json
SHEETS_ID=

# ============================================
# GOOGLE APPS SCRIPT (Scratch Card System)
# ============================================
# Deploy the ISX License Manager as a web app
GOOGLE_APPS_SCRIPT_URL=https://script.google.com/macros/s/YOUR_SCRIPT_ID/exec
APPS_SCRIPT_SECRET=your-secret-key-here
APPS_SCRIPT_TIMEOUT=30s
APPS_SCRIPT_RETRY_COUNT=3

# Scratch Card Features
ENABLE_SCRATCH_CARD_MODE=false  # Set to true for scratch card deployment
ENABLE_DEVICE_FINGERPRINTING=true
ENABLE_ONE_TIME_ACTIVATION=true

# Scratch Card Security
SCRATCH_CARD_MAX_ATTEMPTS_PER_HOUR=10
SCRATCH_CARD_BLOCK_DURATION_HOURS=24
SCRATCH_CARD_RATE_LIMIT_PER_IP=10
SCRATCH_CARD_VALIDATION_TIMEOUT=30s

# ============================================
# WEBSOCKET CONFIGURATION
# ============================================
ENABLE_WEBSOCKET=true
WS_PING_INTERVAL=30s
WS_PONG_TIMEOUT=10s
WS_MAX_CONNECTIONS=100

# ============================================
# FILE STORAGE PATHS
# ============================================
DATA_DIR=./data
DOWNLOADS_DIR=./data/downloads
REPORTS_DIR=./data/reports
CACHE_DIR=./data/cache
LOGS_DIR=./logs

# ============================================
# PERFORMANCE TUNING
# ============================================
MAX_WORKERS=10
BATCH_SIZE=100
TIMEOUT=30s
CACHE_TTL=5m
CACHE_SIZE=1000

# ============================================
# EXTERNAL APIS
# ============================================
ISX_API_URL=https://www.isx-iq.net
ISX_API_TIMEOUT=30s
ISX_API_RETRY_COUNT=3

# ============================================
# DEVELOPMENT & DEBUGGING
# ============================================
DEBUG=false                  # Enable debug mode
SKIP_LICENSE_CHECK=false     # Skip license validation (dev only)
ALLOW_INSECURE_FOR_TEST=false  # Allow insecure connections (test only)
SCRATCH_CARD_TEST_MODE=false   # Enable test mode for scratch cards

# ============================================
# MCP INTEGRATIONS (Optional)
# ============================================
# GitHub MCP - Create token at https://github.com/settings/tokens
GITHUB_TOKEN=

# Sentry MCP - Get from https://sentry.io/settings/account/api/auth-tokens/
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# ============================================
# PRODUCTION-SPECIFIC OVERRIDES
# ============================================
# Uncomment these in .env.production:
# ENV=production
# LOG_FORMAT=json
# ENABLE_SECURE_MODE=true
# DEBUG=false
# SKIP_LICENSE_CHECK=false
# ALLOW_INSECURE_FOR_TEST=false